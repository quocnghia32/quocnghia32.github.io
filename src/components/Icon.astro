---
import { iconFor, type SocialId } from '../lib/socials';

interface Props {
  id: SocialId;
  size?: number;
}
const { id, size = 20 } = Astro.props;
const icon = iconFor(id);
---
{icon.mode === 'fill' ? (
  <svg width={size} height={size} viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
    <path d={icon.path} />
  </svg>
) : (
  <svg width={size} height={size} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round" stroke-linecap="round" aria-hidden="true">
    <path d={icon.path} />
  </svg>
)}
