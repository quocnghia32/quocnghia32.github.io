---
import '../styles/global.css';
import { NAV_ITEMS, isActive } from '../lib/nav';
import { profile } from '../data/profile';

interface Props {
  title: string;
  description: string;
}
const { title, description } = Astro.props;
const path = Astro.url.pathname;
const fullTitle = title === 'Home' ? `${profile.name} · AI Engineer` : `${title} · ${profile.name}`;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta name="theme-color" content="#fafaf7" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Geist:wght@400;500;600&family=JetBrains+Mono:wght@400;500&family=Space+Grotesk:wght@500;600;700&display=swap"
    />
    <script is:inline>document.documentElement.classList.add('js');</script>
  </head>
  <body>
    <a class="skip" href="#content">Skip to content</a>
    <header class="site-header" data-site-header>
      <nav aria-label="Primary">
        <a href="/" class="logo" data-logo>{profile.logo}</a>
        <div class="links">
          {NAV_ITEMS.map((item) => (
            <a
              class="ul"
              href={item.href}
              data-nav-link
              aria-current={isActive(path, item.href) ? 'page' : undefined}
            >
              {item.label}
            </a>
          ))}
        </div>
      </nav>
    </header>

    <main id="content">
      <slot />
    </main>

    <footer class="site-footer">
      <div>
        <span>© {new Date().getFullYear()} {profile.name}</span>
        <span>{profile.footerLine}</span>
      </div>
    </footer>

    <script>
      import { initAll } from '../scripts/main';
      initAll();
    </script>
  </body>
</html>

<style>
  .skip { position: absolute; left: 16px; top: -60px; z-index: 50; padding: 10px 14px; background: var(--ink); color: var(--bg); border-radius: 8px; }
  .skip:focus { top: 12px; }

  .site-header {
    position: sticky; top: 0; z-index: 20;
    border-bottom: 1px solid var(--line);
    background: var(--bg);
    transition: background 0.3s, backdrop-filter 0.3s, border-color 0.3s;
  }
  .site-header[data-scrolled='true'] {
    background: rgba(250, 250, 247, 0.7);
    backdrop-filter: blur(14px) saturate(1.4);
    -webkit-backdrop-filter: blur(14px) saturate(1.4);
  }
  nav {
    max-width: 1200px; margin: 0 auto; padding: 16px 32px;
    display: flex; flex-wrap: wrap; gap: 12px 28px; align-items: center; justify-content: space-between;
  }
  .logo { font: 700 18px var(--font-display); color: var(--ink); letter-spacing: -0.01em; }
  .links { display: flex; flex-wrap: wrap; gap: 6px 22px; font-size: 14px; }
  .links a { color: var(--muted); padding: 6px 0; }
  .links a:hover, .links a[aria-current='page'] { color: var(--ink); }
  .links a[aria-current='page'] { font-weight: 600; }

  .site-footer { border-top: 1px solid var(--line); }
  .site-footer div {
    max-width: 1200px; margin: 0 auto; padding: 22px 32px;
    display: flex; flex-wrap: wrap; gap: 8px 24px; justify-content: space-between; font-size: 13px; color: var(--muted);
  }

  @media (max-width: 640px) {
    nav { padding: 12px 0 0; gap: 6px; }
    .logo { padding: 0 16px; }
    .links {
      width: 100%; flex-wrap: nowrap; overflow-x: auto; gap: 18px; padding: 2px 16px 10px; font-size: 14px;
      scrollbar-width: none; mask-image: linear-gradient(90deg, #000 85%, transparent);
    }
    .links::-webkit-scrollbar { display: none; }
    .links a { flex: none; }
    .site-footer div { padding: 20px 16px; }
  }
</style>
