---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import { profile } from '../data/profile';
import { CONTACT_ROWS } from '../lib/socials';
---
<Base title="Contact" description="Contact Nguyen Quoc Nghia by email, LinkedIn, GitHub or Codeforces.">
  <div class="wrap">
    <div>
      <p class="eyebrow" data-reveal>~/contact</p>
      <h1 class="page-title" data-reveal style="--i:1">Let's build something that has to be right.</h1>
      <p class="lede" data-reveal style="--i:2">Open to AI engineering roles, research collaborations and good contest problems.</p>

      <div class="copybox" data-reveal style="--i:3">
        <span class="mono addr">{profile.email}</span>
        <button type="button" class="btn btn-solid" data-copy={profile.email}>Copy email</button>
      </div>

      <ul class="rows" data-reveal style="--i:4">
        {CONTACT_ROWS.map((s) => (
          <li>
            <a
              class="row"
              data-social-row
              href={s.href}
              target="_blank"
              rel="noopener noreferrer"
            >
              <span class="ico"><Icon id={s.id} /></span>
              <span class="name">{s.label}</span>
              <span class="handle muted">{s.handle}</span>
              <span class="arr" aria-hidden="true">↗</span>
            </a>
          </li>
        ))}
      </ul>
    </div>

    <form class="card form" data-contact data-to={profile.email} novalidate aria-labelledby="form-h" data-spotlight data-reveal style="--i:3">
      <h2 id="form-h">Send a message</h2>
      <div class="field">
        <label for="c-name">Name</label>
        <input id="c-name" name="name" type="text" autocomplete="name" aria-describedby="err-name" />
        <p class="err" id="err-name" data-error-for="name" aria-live="polite"></p>
      </div>
      <div class="field">
        <label for="c-email">Email</label>
        <input id="c-email" name="email" type="email" autocomplete="email" aria-describedby="err-email" />
        <p class="err" id="err-email" data-error-for="email" aria-live="polite"></p>
      </div>
      <div class="field">
        <label for="c-message">Message</label>
        <textarea id="c-message" name="message" rows="5" aria-describedby="err-message"></textarea>
        <p class="err" id="err-message" data-error-for="message" aria-live="polite"></p>
      </div>
      <button type="submit" class="btn send">Send message <span class="arr" aria-hidden="true">→</span></button>
      <p class="muted hint">Opens your mail app with the message filled in.</p>
    </form>
  </div>
</Base>

<style>
  .wrap { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 360px), 1fr)); gap: 56px; }
  .copybox { display: flex; flex-wrap: wrap; align-items: center; gap: 10px; padding: 8px 8px 8px 18px; background: var(--surface); border: 1px solid var(--line); border-radius: 14px; margin-bottom: 28px; }
  .addr { flex: 1 1 220px; font-size: 15px; overflow-wrap: anywhere; }
  .copybox .btn { min-height: 44px; border-radius: 10px; min-width: 128px; }

  .rows { margin: 0; padding: 0; list-style: none; border-top: 1px solid var(--ink); }
  .row {
    display: grid; grid-template-columns: 40px auto 1fr auto; align-items: center; gap: 12px;
    min-height: 64px; border-bottom: 1px solid var(--line); color: var(--ink); font-size: 18px; font-weight: 500;
    transition: padding 0.25s var(--ease), color 0.25s;
  }
  .row:hover { padding-left: 10px; color: var(--blue); }
  .ico { display: grid; place-items: center; width: 40px; height: 40px; border-radius: 10px; border: 1px solid var(--line); background: var(--surface); transition: background 0.25s, color 0.25s, border-color 0.25s; }
  .row:hover .ico { background: var(--blue); color: #fff; border-color: var(--blue); }
  .handle { font-size: 15px; font-weight: 400; overflow-wrap: anywhere; }

  .form { align-self: start; padding: 32px; display: flex; flex-direction: column; gap: 14px; border-radius: 20px; }
  .form:hover { transform: none; }
  .form h2 { font-size: 22px; font-weight: 600; }
  .field { display: flex; flex-direction: column; gap: 6px; }
  label { font-size: 14px; font-weight: 500; }
  input, textarea {
    min-height: 46px; padding: 10px 14px; border: 1px solid var(--line); border-radius: 10px; background: var(--bg);
    font: 16px/1.5 var(--font-body); color: var(--ink); transition: border-color 0.2s, box-shadow 0.2s;
  }
  textarea { resize: vertical; }
  input:focus, textarea:focus { outline: none; border-color: var(--blue); box-shadow: 0 0 0 3px var(--blue-soft); }
  [aria-invalid='true'] { border-color: #c0362c; }
  .err { min-height: 1em; font-size: 13px; color: #b42318; }
  .send { background: var(--blue); border-color: var(--blue); color: #fff; }
  .send:hover { background: var(--ink); border-color: var(--ink); }
  .hint { font-size: 13px; }
</style>
