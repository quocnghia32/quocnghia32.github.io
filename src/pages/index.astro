---
import Base from '../layouts/Base.astro';
import Socials from '../components/Socials.astro';
import { profile, strengths, terminal } from '../data/profile';

const lines = [profile.firstLine, profile.secondLine];
let k = 0;
const letters = lines.map((line) => [...line].map((ch) => ({ ch, d: k++ })));
---
<Base title="Home" description="Nguyen Quoc Nghia, AI Engineer at MoMo. LLM agents, evaluation and agent infrastructure.">
  <section class="hero" aria-labelledby="hero-name">
    <div class="blob b1" aria-hidden="true"></div>
    <div class="blob b2" aria-hidden="true"></div>

    <div class="copy">
      <p class="pill mono" data-reveal style="--i:0"><span class="dot"></span>AI ENGINEER I @ MOMO</p>
      <h1 id="hero-name" aria-label={profile.name}>
        {letters.map((line, li) => (
          <span class={li === 1 ? 'line accent' : 'line'} aria-hidden="true">
            {line.map(({ ch, d }) => (
              <span class="ch" style={`--d:${d}`}>{ch === ' ' ? ' ' : ch}</span>
            ))}
          </span>
        ))}
      </h1>
      <p class="role" data-reveal style="--i:3"><span class="dash" aria-hidden="true"></span>AI Engineer I <span class="sep" aria-hidden="true">|</span> MoMo</p>
      <p class="bio" data-bio data-reveal style="--i:4">
        AI Engineer with a B.S. in Computer Science (APCS) from the University of Science, VNU-HCM, building the data agent platform at MoMo.
        I work where AI meets software: agentic AI, evaluation, memory and harness, shipped to production as scalable, reliable systems.
      </p>
      <div class="ctas" data-reveal style="--i:5">
        <a class="btn btn-solid" href="/projects/">View projects <span class="arr" aria-hidden="true">→</span></a>
        <a class="btn btn-ghost" href={profile.cv} download>Download CV</a>
      </div>
      <div class="connect" data-reveal style="--i:6">
        <span class="mono label">CONNECT</span>
        <Socials />
      </div>
    </div>

    <div class="visual" data-hero-visual data-reveal style="--i:2">
      <figure class="photo">
        <img data-portrait src="/images/portrait.jpg" alt="Portrait of Nguyen Quoc Nghia" width="800" height="1000" fetchpriority="high" decoding="async" />
      </figure>
    <figure class="term" data-terminal>
      <div class="bar" aria-hidden="true"><span></span><span></span><span></span><em class="mono">~/nghia</em></div>
      <div class="body mono">
        {terminal.map((t) => (
          <p data-cmd><span class="prompt">$</span> {t.cmd}</p>
          <p class="out">{t.out}</p>
        ))}
        <p><span class="prompt">$</span> <span class="caret" aria-hidden="true"></span></p>
      </div>
      <figcaption class="sr-only">Terminal-style introduction</figcaption>
    </figure>
    </div>
  </section>

  <section class="strengths" data-overview aria-labelledby="st-h">
    <div class="st-head">
      <p class="eyebrow" data-reveal>~/strengths</p>
      <h2 id="st-h" class="st-title" data-reveal style="--i:1">Where AI meets software.</h2>
      <p class="st-lede" data-reveal style="--i:2">Building the model side is half the job. The other half is making it run for real users.</p>
    </div>

    <div class="vmap" data-reveal>
      {([['ai', 'AI', strengths.ai], ['sw', 'Software', strengths.sw]] as const).map(([key, name, items]) => (
        <ul class={`notes ${key}`} data-strength-col={key} aria-label={name}>
          {items.map((s, i) => (
            <li class="note" data-strength style={`--n:${i}`}>
              <h3>{s.title}</h3>
              <p>{s.text}</p>
            </li>
          ))}
        </ul>
      ))}

      <svg class="venn" data-venn viewBox="0 0 440 260" role="img" aria-label="Venn diagram: my work sits where AI and software engineering overlap, agents in production">
        <defs>
          <linearGradient id="lens-fill" x1="0" y1="0" x2="0" y2="1">
            <stop offset="0" stop-color="#4a6cff"></stop>
            <stop offset="1" stop-color="#2348e0"></stop>
          </linearGradient>
        </defs>
        <g class="slide-ai">
          <circle class="fill-ai" data-venn-part="ai" cx="165" cy="130" r="110"></circle>
        </g>
        <g class="slide-sw">
          <circle class="fill-sw" data-venn-part="sw" cx="275" cy="130" r="110"></circle>
        </g>
        <path class="lens" data-lens data-venn-part="both" d="M220 34.74 A110 110 0 0 1 220 225.26 A110 110 0 0 1 220 34.74 Z"></path>
        <g class="slide-ai">
          <circle class="ring ring-ai" cx="165" cy="130" r="110"></circle>
          <g class="orbit orbit-ai"><circle class="sat" cx="165" cy="20" r="4"></circle></g>
          <text class="tag tag-ai" x="110" y="134" text-anchor="middle">AI</text>
        </g>
        <g class="slide-sw">
          <circle class="ring ring-sw" cx="275" cy="130" r="110"></circle>
          <g class="orbit orbit-sw"><circle class="sat" cx="275" cy="240" r="4"></circle></g>
          <text class="tag tag-sw" x="330" y="134" text-anchor="middle">SOFTWARE</text>
        </g>
        <text class="lens-txt" x="220" y="124" text-anchor="middle">agents in</text>
        <text class="lens-txt" x="220" y="144" text-anchor="middle">production</text>
      </svg>
    </div>
  </section>
</Base>

<style>
  .hero {
    position: relative;
    min-height: calc(100vh - 220px);
    display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 380px), 1fr));
    gap: 56px; align-items: center; padding: 24px 0;
    overflow-x: clip; overflow-y: visible;
  }
  .blob { position: absolute; border-radius: 50%; filter: blur(70px); pointer-events: none; z-index: -1; }
  .b1 { width: 380px; height: 380px; right: 4%; top: 6%; background: var(--blue); opacity: 0.13; animation: drift 16s ease-in-out infinite; }
  .b2 { width: 260px; height: 260px; left: 30%; bottom: 0; background: #7c9bff; opacity: 0.12; animation: drift 20s ease-in-out infinite reverse; }
  @keyframes drift { 0%, 100% { transform: translate(0, 0) scale(1); } 50% { transform: translate(-40px, 30px) scale(1.1); } }

  .copy { display: flex; flex-direction: column; gap: 20px; }
  .pill {
    align-self: flex-start; display: inline-flex; align-items: center; gap: 10px; padding: 8px 16px;
    border-radius: 999px; font-size: 13px; letter-spacing: 0.06em; color: #fff; background: var(--ink);
  }
  .dot { width: 7px; height: 7px; border-radius: 50%; background: #22a06b; box-shadow: 0 0 0 0 rgba(34, 160, 107, 0.5); animation: ping 2s infinite; }
  @keyframes ping { 70% { box-shadow: 0 0 0 8px rgba(34, 160, 107, 0); } 100% { box-shadow: 0 0 0 0 rgba(34, 160, 107, 0); } }

  h1 { font-weight: 700; font-size: clamp(52px, 8vw, 104px); line-height: 0.95; letter-spacing: -0.04em; }
  .line { display: block; }
  .accent { color: var(--blue); }
  .ch { display: inline-block; animation: letter 0.9s var(--ease) both; animation-delay: calc(var(--d) * 40ms + 120ms); }
  @keyframes letter { from { opacity: 0; filter: blur(14px); transform: translateY(0.25em); } }

  .role { display: flex; align-items: center; gap: 18px; font-size: 22px; font-weight: 500; letter-spacing: 0.01em; color: var(--ink-2); }
  .dash { width: 56px; height: 3px; border-radius: 3px; background: linear-gradient(90deg, var(--blue), rgba(35, 72, 224, 0)); }
  .sep { color: var(--muted); font-weight: 300; }
  .bio { font-size: 18px; line-height: 1.65; color: var(--ink-2); max-width: 34rem; }
  .ctas { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 4px; }
  .connect { display: flex; flex-wrap: wrap; align-items: center; gap: 12px 28px; margin-top: 10px; }
  .label { font-size: 12px; letter-spacing: 0.22em; color: var(--muted); }

  .visual { position: relative; isolation: isolate; justify-self: end; width: min(100%, 380px); margin: 24px 24px 56px 0; }
  /* soft blue glow behind the photo */
  .visual::after {
    content: ''; position: absolute; inset: -8% -10%; z-index: -2; border-radius: 50%;
    background: radial-gradient(closest-side, rgba(35, 72, 224, 0.22), transparent); filter: blur(30px);
  }
  /* offset outline frame peeking out at the top right */
  .visual::before {
    content: ''; position: absolute; z-index: -1; top: -22px; right: -22px; width: 46%; height: 38%;
    border: 1.5px solid rgba(35, 72, 224, 0.45); border-radius: 20px;
  }
  .photo {
    margin: 0; aspect-ratio: 4 / 5; border-radius: 24px; overflow: hidden; background: #dfe5d9;
    box-shadow: 0 40px 80px -40px rgba(18, 19, 23, 0.45), 0 0 0 1px rgba(18, 19, 23, 0.06);
  }
  .photo img { display: block; width: 100%; height: 100%; object-fit: cover; transition: transform 0.9s var(--ease); }
  .visual:hover .photo img { transform: scale(1.035); }
  .term {
    position: absolute; left: -56px; bottom: -40px; width: 270px;
    margin: 0; background: var(--term-bg); color: var(--term-ink); border-radius: 14px; overflow: hidden;
    box-shadow: 0 24px 48px -20px rgba(18, 19, 23, 0.55); animation: float 6s ease-in-out infinite;
  }
  @keyframes float { 50% { transform: translateY(-6px); } }
  .bar { display: flex; align-items: center; gap: 7px; padding: 9px 14px; border-bottom: 1px solid #2a2c33; }
  .bar span { width: 8px; height: 8px; border-radius: 50%; background: #3a3d45; }
  .bar em { margin-left: 8px; font-style: normal; font-size: 12px; color: #8b8e97; }
  .body { padding: 12px 14px 14px; font-size: 12px; line-height: 1.7; }
  .prompt { color: var(--term-prompt); }
  .out { color: var(--term-dim); margin-bottom: 6px; white-space: nowrap; }
  .caret { display: inline-block; width: 9px; height: 17px; background: var(--term-ink); vertical-align: -3px; animation: blink 1s steps(1) infinite; }
  @keyframes blink { 50% { opacity: 0; } }
  @media (max-width: 760px) {
    .visual { justify-self: center; width: min(100%, 340px); margin: 12px 0 8px; }
    .visual::before { right: -12px; top: -12px; }
    .term { position: relative; left: auto; bottom: auto; width: auto; margin: -44px 18px 0; }
  }

  /* ---------- strengths: Venn with notes around it ---------- */
  .strengths { padding: 72px 0 40px; border-top: 1px solid var(--line); }
  .st-head { text-align: center; max-width: 40rem; margin: 0 auto 40px; }
  .st-title { font-size: clamp(32px, 4vw, 48px); line-height: 1.05; letter-spacing: -0.03em; margin-bottom: 12px; }
  .st-lede { color: var(--ink-2); }

  .vmap {
    display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 440px) minmax(0, 1fr);
    grid-template-areas: 'ai venn sw'; align-items: center; gap: 0 8px;
  }
  .notes { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 34px; }
  .notes.ai { grid-area: ai; text-align: right; }
  .notes.sw { grid-area: sw; }
  .venn { grid-area: venn; width: 100%; overflow: visible; }

  .note { position: relative; padding: 0 64px; }
  .note h3 { font-size: 18px; font-weight: 600; line-height: 1.3; transition: color 0.3s; }
  .note p { color: var(--ink-2); font-size: 14.5px; margin-top: 2px; }
  /* leader line + dot pointing at the diagram */
  .note::before { content: ''; position: absolute; top: 12px; width: 48px; height: 1px; background: var(--ink); opacity: 0.35; transition: transform 0.7s var(--ease), background 0.3s, opacity 0.3s; }
  .note::after { content: ''; position: absolute; top: 9px; width: 7px; height: 7px; border-radius: 50%; background: var(--ink); transition: background 0.3s, transform 0.3s; }
  .ai .note::before { right: 8px; transform-origin: right; }
  .ai .note::after { right: 0; }
  .sw .note::before { left: 8px; transform-origin: left; }
  .sw .note::after { left: 0; }
  .note:hover h3 { color: var(--blue); }
  .note:hover::before { background: var(--blue); opacity: 1; }
  .note:hover::after { background: var(--blue); transform: scale(1.4); }

  /* entrance: rings slide together, lens pops, lines grow, notes blur in */
  .js .vmap:not(.is-visible) .note { opacity: 0; }
  .js .vmap:not(.is-visible) .note::before { transform: scaleX(0); }
  .js .vmap.is-visible .notes.ai .note { animation: note-in-ai 0.7s var(--ease) backwards; animation-delay: calc(0.9s + var(--n) * 0.15s); }
  .js .vmap.is-visible .notes.sw .note { animation: note-in-sw 0.7s var(--ease) backwards; animation-delay: calc(0.9s + var(--n) * 0.15s); }
  .js .vmap.is-visible .note::before { animation: line-in 0.6s var(--ease) backwards; animation-delay: calc(1.1s + var(--n) * 0.15s); }
  @keyframes note-in-ai { from { opacity: 0; filter: blur(8px); transform: translateX(-16px); } }
  @keyframes note-in-sw { from { opacity: 0; filter: blur(8px); transform: translateX(16px); } }
  @keyframes line-in { from { transform: scaleX(0); } }

  .fill-ai { fill: rgba(35, 72, 224, 0.06); }
  .fill-sw { fill: rgba(18, 19, 23, 0.035); }
  .ring { fill: none; stroke: var(--ink); stroke-width: 1.25; opacity: 0.85; transition: stroke 0.3s, stroke-width 0.3s; }
  .tag { font: 500 12px var(--font-mono); letter-spacing: 0.16em; fill: var(--muted); }
  .lens { fill: url(#lens-fill); transform-box: fill-box; transform-origin: center; transition: opacity 0.8s 0.6s var(--ease), transform 0.8s 0.6s var(--ease); animation: glow 3.2s ease-in-out infinite; }
  .lens-txt { font: 600 14px var(--font-body); fill: #fff; transition: opacity 0.6s 1s; }
  .sat { fill: var(--blue); }
  .slide-ai, .slide-sw { transition: transform 1.1s var(--ease); }
  .js .vmap:not(.is-visible) .slide-ai { transform: translateX(-40px); }
  .js .vmap:not(.is-visible) .slide-sw { transform: translateX(40px); }
  .js .vmap:not(.is-visible) .lens { opacity: 0; transform: scale(0.5); }
  .js .vmap:not(.is-visible) .lens-txt { opacity: 0; }

  /* idle motion */
  .orbit { transform-box: view-box; animation: spin 14s linear infinite; }
  .orbit-ai { transform-origin: 165px 130px; }
  .orbit-sw { transform-origin: 275px 130px; animation-direction: reverse; animation-duration: 18s; }
  @keyframes spin { to { transform: rotate(360deg); } }
  @keyframes glow { 50% { filter: drop-shadow(0 0 14px rgba(35, 72, 224, 0.45)); } }

  /* hovering a side of the Venn lights up that circle and its notes (nothing else dims) */
  .fill-ai, .fill-sw { transition: fill 0.35s; }
  .lens-txt, .tag { pointer-events: none; }
  .ring { pointer-events: none; }
  .tag { transition: fill 0.3s; }
  .vmap:has(.fill-ai:hover) .fill-ai { fill: rgba(35, 72, 224, 0.16); }
  .vmap:has(.fill-sw:hover) .fill-sw { fill: rgba(35, 72, 224, 0.12); }
  .vmap:has(.fill-ai:hover) .ring-ai,
  .vmap:has(.fill-sw:hover) .ring-sw { stroke: var(--blue); stroke-width: 2; opacity: 1; filter: drop-shadow(0 0 6px rgba(35, 72, 224, 0.5)); }
  .vmap:has(.fill-ai:hover) .tag-ai,
  .vmap:has(.fill-sw:hover) .tag-sw { fill: var(--blue); font-weight: 600; }
  .vmap:has(.lens:hover) .lens { animation: none; filter: drop-shadow(0 0 22px rgba(35, 72, 224, 0.7)); }

  .vmap:has(.fill-ai:hover) .notes.ai .note h3,
  .vmap:has(.fill-sw:hover) .notes.sw .note h3,
  .vmap:has(.lens:hover) .note h3 { color: var(--blue); }
  .vmap:has(.fill-ai:hover) .notes.ai .note::before,
  .vmap:has(.fill-sw:hover) .notes.sw .note::before,
  .vmap:has(.lens:hover) .note::before { background: var(--blue); opacity: 1; }
  .vmap:has(.fill-ai:hover) .notes.ai .note::after,
  .vmap:has(.fill-sw:hover) .notes.sw .note::after,
  .vmap:has(.lens:hover) .note::after { background: var(--blue); transform: scale(1.4); }

  /* hovering a note lights up its circle */
  .vmap:has(.notes.ai .note:hover) .ring-ai,
  .vmap:has(.notes.sw .note:hover) .ring-sw { stroke: var(--blue); stroke-width: 2; opacity: 1; }

  @media (max-width: 900px) {
    .vmap { grid-template-columns: 1fr 1fr; grid-template-areas: 'venn venn' 'ai sw'; gap: 32px 24px; }
    .venn { max-width: 420px; justify-self: center; }
    .notes.ai { text-align: left; }
    .note { padding: 0 0 0 18px; }
    .note::before { display: none; }
    .ai .note::after, .sw .note::after { left: 0; right: auto; }
  }
  @media (max-width: 560px) {
    .vmap { grid-template-columns: 1fr; grid-template-areas: 'venn' 'ai' 'sw'; }
  }
</style>
